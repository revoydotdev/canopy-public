# Revoy loads this file through the Bun launcher. Copy it to `.env`; `.env`
# and every provider secret remain gitignored. Configure only what you use.

# Provider-independent override (highest precedence for native execution)
# ARBOR_NATIVE_API_KEY=

# Subordinate harness integration. OpenCode is the compatibility default.
# `claude-code` uses the CLI's existing OAuth login without reading its tokens.
# ARBOR_HARNESS_INTEGRATION=claude-code
# ARBOR_CLAUDE_CODE_MODEL=sonnet

# Provider-standard API credentials
# OPENROUTER_API_KEY=
# Ollama Cloud API key (local Ollama does not need one).
# OLLAMA_API_KEY=
# OPENAI_API_KEY=
# Optional pre-exchanged OpenAI API workload identity token (Unix-seconds expiry).
# Canopy uses it only for native OpenAI inference and does not exchange/refresh it.
# OPENAI_WIF_ACCESS_TOKEN=
# OPENAI_WIF_EXPIRES_AT=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# HF_TOKEN=
# HUGGINGFACE_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=

# Claude Code OAuth is intentionally not an exported token. Authenticate the
# Claude Code integration with `claude login`; its plugin invokes the CLI and
# never reads or copies Claude Code's credential store.
