{
  "id": "lifecycle-plan",
  "title": "L2→L9: submit a real request, let the configured connector run it to a terminal state, then review",
  "covers": [
    "L1",
    "L2",
    "L3",
    "L9",
    "S01b",
    "S13",
    "X11"
  ],
  "seed": "greenfield",
  "steps": [
    {
      "wait_for": "❯",
      "timeout_s": 60,
      "label": "launch: Console ready",
      "hold_s": 1
    },
    {
      "type": "Add a greet(name) function to src/greeting.ts that returns a friendly message, and a test for it.",
      "label": "type the request",
      "hold_s": 1
    },
    {
      "key": "Enter",
      "label": "send to planning",
      "hold_s": 2
    },
    {
      "wait_for": "Planning your request|TASK ·",
      "timeout_s": 60,
      "label": "planning acknowledged",
      "hold_s": 3
    },
    {
      "wait_for": "OUTCOME ·|NEEDS YOU ·",
      "fail_on": "revoy2 crashed",
      "timeout_s": 1800,
      "label": "terminal or blocked state",
      "hold_s": 8
    },
    {
      "key": "Escape",
      "label": "blur",
      "hold_s": 0.5
    },
    {
      "key": "t",
      "label": "Tree",
      "hold_s": 2
    },
    {
      "key": "9",
      "label": "Jobs",
      "hold_s": 2
    },
    {
      "key": "4",
      "label": "Output",
      "hold_s": 2
    },
    {
      "key": "d",
      "label": "DevTools",
      "hold_s": 2
    },
    {
      "key": "S-r",
      "label": "Diff Review",
      "hold_s": 3
    },
    {
      "key": "Escape",
      "label": "dismiss",
      "hold_s": 1
    },
    {
      "key": "`",
      "label": "Console final",
      "hold_s": 3
    }
  ]
}
