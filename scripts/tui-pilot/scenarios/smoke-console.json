{
  "id": "smoke-console",
  "title": "Apparatus smoke: launch, type, navigate with the keys tmux could not send",
  "covers": ["S01", "S25", "S08", "X01"],
  "steps": [
    { "wait_for": "❯", "timeout_s": 60, "label": "launch: Console ready", "hold_s": 1 },
    { "key": "Enter", "label": "focus composer", "hold_s": 0.5 },
    { "type": "refactor", "label": "type prose", "hold_s": 0.5 },
    { "key": "Escape", "label": "blur composer", "hold_s": 0.5 },
    { "key": ";", "label": "Surveillance via bare semicolon", "hold_s": 1 },
    { "key": "\\", "label": "leader chord: backslash", "hold_s": 0.3 },
    { "key": "1", "label": "leader chord: 1 -> Campaigns", "hold_s": 1 },
    { "key": "C-p", "label": "open palette", "hold_s": 1 },
    { "key": "Escape", "label": "close palette", "hold_s": 0.5 },
    { "key": "`", "label": "back to Console", "hold_s": 1 }
  ]
}
