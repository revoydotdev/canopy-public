{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "outDir": "./dist",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "references": [
    { "path": "packages/arbor-core" },
    { "path": "packages/arbor-campaign-support" },
    { "path": "packages/arbor-claude-bridge" },
    { "path": "packages/arbor-harness" },
    { "path": "packages/arbor-config" },
    { "path": "packages/arbor-prompts" },
    { "path": "packages/arbor-kb" },
    { "path": "packages/arbor-gate" },
    { "path": "packages/arbor-mcp" },
    { "path": "packages/arbor-audit" },
    { "path": "packages/arbor-opencode" },
    { "path": "packages/arbor-eval" },
    { "path": "packages/arbor-tui" },
    { "path": "packages/arbor-governance" },
    { "path": "packages/arbor-search-runtime" }
  ],
  "files": []
}
